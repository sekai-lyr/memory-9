<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.sekai_form.mapper.SekaiFormUserMapper">
    <insert id="insert" parameterType="com.sekai.sekai_form.dataobject.SekaiFormUserDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_form_user(user_name, password, nick_name, avatar_url)
        VALUES (#{userName}, #{password}, #{nickName}, #{avatarUrl})
    </insert>

    <select id="findByUserName" resultType="com.sekai.sekai_form.dataobject.SekaiFormUserDO">
        SELECT * FROM sekai_form_user WHERE user_name = #{userName} LIMIT 1
    </select>

    <select id="findById" resultType="com.sekai.sekai_form.dataobject.SekaiFormUserDO">
        SELECT * FROM sekai_form_user WHERE id = #{id} LIMIT 1
    </select>
</mapper>